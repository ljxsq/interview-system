# 复制为 .env.local 并填入真实值（.env.local 已被 git 忽略，勿提交）。
# 所有变量只在服务端读取，不要写进 NEXT_PUBLIC_*。

# 登录 JWT（HS256）签名密钥；32 字节随机串，生成方式：
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Coze 个人访问令牌，用于工作流调用、视频与图片上传
COZE_PAT=pat_xxxxxxxxxxxxxxxxxxxxxxxx

# 出题工作流 ID（Coze 控制台可见，数字串）
COZE_WORKFLOW_ID_PREP=

# 评估工作流 ID
COZE_WORKFLOW_ID_EVAL=

# JD 截图图片识别工作流 ID
COZE_WORKFLOW_ID_OCR=
